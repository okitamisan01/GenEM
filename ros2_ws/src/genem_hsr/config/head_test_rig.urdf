<?xml version="1.0"?>
<!-- Original minimal test mechanism, not a redistributed Toyota robot model. -->
<robot name="genem_two_joint_test_rig">
  <link name="base_link"/>
  <link name="pan_link"/>
  <link name="tilt_link"/>
  <joint name="head_pan_joint" type="revolute">
    <parent link="base_link"/><child link="pan_link"/>
    <axis xyz="0 0 1"/><limit lower="-0.5" upper="0.5" velocity="0.25" effort="1"/>
  </joint>
  <joint name="head_tilt_joint" type="revolute">
    <parent link="pan_link"/><child link="tilt_link"/>
    <axis xyz="0 1 0"/><limit lower="-0.3" upper="0.3" velocity="0.25" effort="1"/>
  </joint>
  <ros2_control name="GenEMHeadTestRig" type="system">
    <hardware><plugin>mock_components/GenericSystem</plugin></hardware>
    <joint name="head_pan_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="head_tilt_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
