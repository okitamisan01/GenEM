# Match the HSR/simulator domain when connecting to it.
ROS_DOMAIN_ID=42
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
# Only needed for --backend api. Never commit docker/.env.
GENEM_API_BASE=https://your-provider.example/v1
GENEM_MODEL=your-model-name
GENEM_API_KEY=

# For remote robot discovery use SUBNET above after matching the ROS domain.
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp
